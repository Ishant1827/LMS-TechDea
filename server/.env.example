# Copy to .env and adjust. .env is git-ignored.
PORT=5000

# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/techdea_lms
# ...or MongoDB Atlas (free cloud, no install):
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/techdea_lms

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES=7d

CLIENT_ORIGIN=http://localhost:5173

# ── Email ──────────────────────────────────────────────────────────────
# smtp    real delivery
# console prints the message to this terminal instead of sending (default in dev)
# json    returns the message as JSON (tests)
# Unset in production means outbound email is disabled; console and json are
# refused there, because they would write one-time codes into the logs.
MAIL_TRANSPORT=console

MAIL_FROM=techdea.lms@example.com
MAIL_FROM_NAME=TechDea LMS
# Absolute https URL of the logo shown in the email header. Anything else — a
# relative path, http, or unset — drops the image and the header falls back to
# the wordmark, which is also what a recipient with images off sees.
MAIL_LOGO_URL=https://lms-client-szuv.onrender.com/techdea-logo.png
# MAIL_REPLY_TO=support@example.com

# Keys the one-time codes. Independent of JWT_SECRET, and required — without it
# the server refuses to start rather than issuing codes it cannot protect.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OTP_PEPPER=replace-with-32-plus-random-characters

# Only read when MAIL_TRANSPORT=smtp.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587          # 587 with STARTTLS, or 465 for implicit TLS. Never 25.
# SMTP_SECURE=false      # true only for port 465
# SMTP_USER=
# SMTP_PASS=             # a Gmail app password, never the account password

# Seed admin (used by: npm run seed)
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@techdea.local
SEED_ADMIN_PASSWORD=admin12345
