# Copy to .env and adjust. .env is git-ignored.
PORT=5000

# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/techdea_lms
# ...or MongoDB Atlas (free cloud, no install):
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/techdea_lms

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES=7d

CLIENT_ORIGIN=http://localhost:5173

# ── Email ──────────────────────────────────────────────────────────────
# console  prints the message to this terminal instead of sending (default in dev)
# json     returns the message as JSON (tests)
#
# Unset in production means outbound email is disabled: the app boots and serves
# normally, every send is logged and skipped, and nothing is gated on a code
# nobody can receive. Password recovery is by admin — Admin > Users > Set
# password. console and json are refused in production, because they would write
# one-time codes into the logs.
#
# There is no real transport at the moment — SMTP was removed because Render's
# free plan blocks its ports. See src/shared/mail/transport.js for what adding
# one would take.
MAIL_TRANSPORT=console

MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=TechDea LMS
# MAIL_REPLY_TO=support@example.com

# Absolute https URL of the logo shown in the email header. Anything else — a
# relative path, http, or unset — drops the image and the header falls back to
# the wordmark, which is also what a recipient with images off sees.
MAIL_LOGO_URL=https://lms-client-szuv.onrender.com/techdea-logo.png

# Keys the one-time codes. Required whenever mail is enabled — without it the
# server refuses to start rather than issuing codes it cannot protect.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OTP_PEPPER=replace-with-32-plus-random-characters

# Seed admin (used by: npm run seed)
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@techdea.local
SEED_ADMIN_PASSWORD=admin12345
